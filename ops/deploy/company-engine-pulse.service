[Unit]
Description=Sovereign Agency OS - factory pulse loop (one beat every PULSE_INTERVAL)
After=network-online.target company-engine.service
Wants=company-engine.service

[Service]
Type=simple
WorkingDirectory=/srv/company-engine
EnvironmentFile=/srv/company-engine/.env
Environment=PYTHONPATH=/srv/company-engine

# entrypoint.sh owns the loop; pulse.py stays one-pass. The loop tolerates a
# failed beat and keeps going — the factory must not stop because one capsule
# misbehaved — so Restart= is not the mechanism that keeps it alive here.
ExecStart=/usr/bin/bash /srv/company-engine/bootstrap/entrypoint.sh

Restart=always
RestartSec=10

User=ubuntu
Group=ubuntu

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/company-engine
ProtectHome=false


[Install]
WantedBy=multi-user.target
