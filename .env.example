# ==============================================================================
# Sovereign Agency OS | Environment Configuration Template (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#    cp .env.example .env
# 2. Fill in your actual credentials below.
# 3. NEVER commit your actual '.env' file to Git / GitHub!
# ==============================================================================

# ==============================================================================
# 1. AI Model Gateway & LLM Providers (بوابة النماذج والذكاء الاصطناعي)
# ==============================================================================
# Primary LLM Configuration (OpenRouter, LiteLLM, OpenAI, Groq, etc.)
AGENCY_LLM_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AGENCY_LLM_BASE_URL=https://openrouter.ai/api/v1
AGENCY_LLM_MODEL=anthropic/claude-3.5-sonnet

# Offline Mode (0 = Live network calls, 1 = Deterministic mock without network)
AGENCY_OFFLINE_MODE=0

# Individual Provider Fallbacks
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=qwen/qwen3.8-27b
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENCODE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LITELLM_MASTER_KEY=sk-master-xxxxxxxxxxxxxxxxxxxxxxxx

# ==============================================================================
# 2. Visual & Design Worker — Image Generation (توليد وتصميم الصور)
# ==============================================================================
# Hugging Face User Access Token (used for FLUX.1-schnell high-speed image rendering)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# ==============================================================================
# 3. Governance & System Paths (مسارات الحوكمة ومصنع الكبسولات)
# ==============================================================================
# Path to governance levels configuration (default: ./config/governance.json)
AGENCY_GOVERNANCE_FILE=./config/governance.json

# Active deliverables spool directory (default: ./data/capsules/spool)
CAPSULES_SPOOL=./data/capsules/spool

# Concurrency & Scaling: maximum parallel worker threads during pulse sweep (default: 8)
AGENCY_MAX_PARALLEL_WORKERS=8

# ------------------------------------------------------------------------------
# 3b. Durable Work Queue (data/queue) — explicit priority scheduling
# ------------------------------------------------------------------------------
# Beside the sweep, the engine keeps a restart-proof queue: one JSON item per
# unit of work (kind capsule.advance = one chained processing pass over one
# capsule), claimed atomically by whichever pulse/API call gets there first.
# Priority is an integer (higher runs first); ties are FIFO. Failed attempts
# retry with exponential backoff, then dead-letter — never silently dropped.
AGENCY_WORK_QUEUE_DIR=./data/queue
# Kill switch for the drain step inside each pulse (default: on)
AGENCY_QUEUE_DRAIN=on
# Max items one drain pass may run (default: 16)
AGENCY_QUEUE_DRAIN_MAX=16
# Lease length for a claimed item; a run longer than this may be reclaimed (default: 900 s)
AGENCY_QUEUE_LEASE_SECONDS=900
# Retry budget per item and the backoff curve (defaults: 3 attempts, 30 s base, 3600 s cap)
AGENCY_QUEUE_MAX_ATTEMPTS=3
AGENCY_QUEUE_BACKOFF_BASE=30
AGENCY_QUEUE_BACKOFF_MAX=3600
# Refuse new work past this many pending items (default: 1000)
AGENCY_QUEUE_MAX_PENDING=1000

# ==============================================================================
# 4. Tool Bridge — swappable delivery gears (الأدوات القابلة للاستبدال)
# ==============================================================================
# The kernel speaks *verbs* (social:publish, text:review, log:summarize, ...) to
# whatever tool answers them, through one contract:
#   docs/architecture/decoupled-tool-bridge.md
#   shared_kernel/schemas/tool_bridge.request|response.schema.json
# Swapping a tool is editing one URL — never a kernel change. A missing
# endpoint/token is a hard refusal (fail closed), not a silent no-op.
AGENCY_BRIDGE_URL=http://127.0.0.1:8799/bridge
AGENCY_BRIDGE_TOKEN=

# Per-verb overrides (optional): point ONE verb at another tool and leave the
# rest alone. Naming rule: AGENCY_BRIDGE_URL_<VERB> with ':' and '-' as '_'.
AGENCY_BRIDGE_URL_SOCIAL_PUBLISH=
AGENCY_BRIDGE_URL_TEXT_REVIEW=
AGENCY_BRIDGE_URL_LOG_SUMMARIZE=
# Same pattern for a per-verb secret: AGENCY_BRIDGE_TOKEN_SOCIAL_PUBLISH=

# Delivery channel used ONLY when a capsule declares none (fail closed without
# it: publishing nowhere on purpose beats publishing somewhere by accident).
AGENCY_DEFAULT_CHANNEL=

# ------------------------------------------------------------------------------
# Gear-side credentials: read by the TOOL that answers the verb, never by the
# kernel. Keep them here so every integration stays one .env away from a swap.
# ------------------------------------------------------------------------------
# Meta / Facebook & Instagram (read by whatever answers social:publish)
FB_PAGE_ID=113658641778838
META_SYSTEM_TOKEN=EAAGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
IG_ACCOUNT_ID=178414xxxxxxxxxxx

# Automation tool credentials (read by whatever answers social:publish/message:*)
N8N_API_KEY=n8n_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
N8N_SECRET=secret-signature-xxxxxxxxxxxx

# Evolution API (WhatsApp Notifications)
EVOLUTION_API_KEY=evo-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Telegram Alerts & Governance Escalation
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=-100xxxxxxxxxx

# ==============================================================================
# 5. Factory Pulse & Cockpit Server (إعدادات النبض والخادم)
# ==============================================================================
# Pulse heartbeat loop frequency in seconds (default: 120)
PULSE_INTERVAL=120

# Engine REST API + cockpit port (default: 8000 — matches the mobile app and
# server_boot.sh; a reverse proxy terminates TLS in front)
PORT=8000

# Bind address. SET THIS EXPLICITLY ON A SERVER:
#   0.0.0.0   -> reachable on every interface (put nginx + TLS in front)
#   127.0.0.1 -> only a reverse proxy on this same host can reach it
# NOTE: ops/server_boot.sh honours PORT/HOST from the shell; the systemd unit
# (ops/deploy/company-engine.service) reads both from this file, so setting
# them here is what pins a production server to one address and port.
HOST=127.0.0.1

# ==============================================================================
# 6. Security — API Authentication & CORS (الأمان والمصادقة)
# ==============================================================================
# ---------------------------------------------------------------------------
# 6a. PRIMARY CREDENTIAL — signed capability keys (مفاتيح القدرات)
# ---------------------------------------------------------------------------
# Every guarded /api/* route declares the capability it requires, and READS ARE
# NOT FREE: any non-mutating route needs `factory:read`. So a cockpit user needs
# `factory:read` PLUS whatever decisions they make, or the dashboard will load
# nothing (the login will report a 403 with the missing grant named).
#
# The kernel refuses to mint or verify anything when this is missing or shorter
# than 32 bytes, so a half-configured deployment fails closed.
#
# Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Then issue keys (the secret is read from this env var, never from argv):
#   python3 tools/mint_capability.py capabilities
#
# BRANCH SCOPING — decisions that act on a branch must say WHICH branch:
#   capsule:approve:marketing   may approve in marketing, nowhere else
#   capsule:approve:*             may approve in every branch (declared aloud)
#   capsule:approve               refused: a scoped capability with no scope
#                                 grants nothing, so it cannot be written
# Engine-wide capabilities (factory:read, pulse:run, ...) take no scope.
#
#   # a reviewer confined to marketing: loads the cockpit, signs off there only
#   python3 tools/mint_capability.py mint --subject abdallah --ttl-days 30 \
#       --capabilities factory:read,capsule:approve,capsule:reject,gate:approve,gate:reject \
#       --scope marketing
#
#   # a read-only dashboard key (engine-wide, no scope)
#   python3 tools/mint_capability.py mint --subject dashboard \
#       --capabilities factory:read --ttl-days 7
#
#   # an operator who also drives the work queue (POST /api/queue*)
#   python3 tools/mint_capability.py mint --subject abdallah --ttl-days 30 \
#       --capabilities factory:read,queue:manage
#
# The cockpit asks for the key once and stores it in your browser only.
AGENCY_CAPABILITY_SECRET=

# ---------------------------------------------------------------------------
# 6a.1 AUDIT LEDGER SECRET — optional dedicated secret for audit hash chains
# ---------------------------------------------------------------------------
# If unset, the audit engine falls back to AGENCY_CAPABILITY_SECRET automatically.
# Set a distinct secret if you wish to separate capability issuing authority
# from the immutable audit journal signing authority.
AGENCY_AUDIT_SECRET=

# ---------------------------------------------------------------------------
# 6b. MIGRATION BRIDGE — the legacy shared token as an explicit ROOT principal
# ---------------------------------------------------------------------------
# Every /api/* call previously required this one shared secret, and anyone who
# held it could do anything. It is still accepted, but now as a ROOT principal
# that is *named in the audit trail* ("<AGENCY_OPERATOR> (legacy shared token)")
# instead of being anonymous. The migration is finished when you set the kill
# switch below to "off"; after that only signed capability keys are accepted.
#
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AGENCY_API_TOKEN=change-me-to-a-long-random-token

# Kill switch for the line above. Set to "off" to require signed keys
# everywhere — this template ships with it OFF, because a fresh deployment has
# no legacy clients to keep alive. (At runtime, UNSET still means enabled, so
# an existing deployment that never set this keeps working after an upgrade;
# an unrecognised value is treated as "off", because a typo must never silently
# keep an omnipotent credential alive.)
#
# While it is enabled, this token satisfies EVERY capability check on EVERY
# route, including branch-scoped ones — so scoping is only real once it is off.
# The server logs a SECURITY warning on every boot until you do.
#
# To finish the migration:
#   1. export AGENCY_CAPABILITY_SECRET=...           (6a above)
#   2. python3 tools/mint_capability.py mint --subject <you> --ttl-days 30 \
#          --capabilities factory:read,capsule:approve,capsule:reject,gate:approve,gate:reject \
#          --scope marketing
#   3. paste that key into the cockpit once (it stays in your browser), confirm
#      the dashboard loads, and only then leave this switch at "off".
AGENCY_LEGACY_ROOT_TOKEN=off

# Human identity recorded in governance decisions (approve / reject). Used as
# the subject of the legacy token above; with signed keys the name comes from
# the key itself. Falls back to "legacy-token" when empty.
AGENCY_OPERATOR=abdallah

# Optional cross-origin allowlist (comma-separated). Empty = same-origin only
# (the cockpit served by this server needs no CORS). Never use "*" with credentials.
AGENCY_CORS_ORIGINS=

# ==============================================================================
# 7. Optional integrations — Directus Kanban studio (التكاملات الاختيارية)
# ==============================================================================
# The factory pulse carries a Directus sync step that mirrors capsules to a
# Kanban board. It is OFF unless explicitly enabled: a host that never
# installed Directus would otherwise dial 127.0.0.1:8055 on every beat and
# meter a failed login into data/finance/usage_ledger.jsonl on a schedule,
# burying the day's real spend evidence.
#
# Turn it on only where Directus is actually reachable. Accepted: 1/true/yes/on
# (case-insensitive). Anything else — including unset — means off.
AGENCY_DIRECTUS_ENABLED=off

# Where the Directus instance answers (default: http://127.0.0.1:8055).
DIRECTUS_INTERNAL_URL=http://127.0.0.1:8055

# Admin identity the bridge logs in with. SET A REAL PASSWORD: the built-in
# fallback the code ships with ("admin_secret_2026") is a known development
# value and must never survive into a network-reachable deployment.
DIRECTUS_ADMIN_EMAIL=admin@agency.local
DIRECTUS_ADMIN_PASSWORD=
